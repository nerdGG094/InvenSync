# === Segredos / ambiente ===
.env
*.env
!.env.example

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# === Ambientes virtuais ===
.venv/
venv/
env/
ENV/

# === Banco de dados local (SQLite legado) ===
instance/*.db
instance/*.sqlite
instance/*.sqlite3
instance/alerts_wpp.txt
# Backups de reparo do cofre (contêm tokens de credenciais — nunca versionar)
instance/credentials_backup_*.json
!instance/.keep

# === Uploads (fotos de perfil) ===
inventory/static/uploads/avatars/*
!inventory/static/uploads/avatars/.keep

# === Uploads (anexos de chamados) ===
inventory/static/uploads/tickets/*
!inventory/static/uploads/tickets/.keep

# === Uploads (notas fiscais das entradas) ===
inventory/static/uploads/nf/*
!inventory/static/uploads/nf/.keep

# === Fotos das credenciais do Cofre (pasta PRIVADA, fora de static) ===
inventory/uploads_private/

# === APK do KioX (binário grande, copiado da pasta KioX; servido em /kiox/apk) ===
inventory/kiox/*.apk

# === Backups do banco (pg_dump) — só a pasta de dumps na RAIZ ===
# (ancorado com "/" p/ não ignorar inventory/templates/backups/)
/backups/

# === go2rtc (CFTV tempo real) — o .yaml gerado contém usuário/senha dos DVRs,
# e o binário é grande; nada disso vai para o Git.
go2rtc/
go2rtc.yaml
go2rtc.exe

# === Logs ===
*.log
flask_output.log

# === IDEs / Editores ===
.idea/
.vscode/
*.swp
*~

# === Sistema ===
.DS_Store
Thumbs.db
snapshot.json
instance/
