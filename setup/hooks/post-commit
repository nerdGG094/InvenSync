#!/bin/sh
# InvenSync - joga o commit recem-feito no board DEV (kanban de desenvolvimento).
#
# Serve a QUALQUER repositorio: o board e compartilhado, e o trabalho de verdade
# esta sempre em dev_commit.py do InvenSync (que fala com o banco). O caminho do
# InvenSync abaixo e preenchido na instalacao por setup/instalar_hooks.ps1.
#
# Este hook NUNCA pode falhar um commit: o commit ja aconteceu quando ele roda,
# entao qualquer problema vira aviso e o hook sai com 0.

invensync="@INVENSYNC@"
repo="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$repo" ] || exit 0

py="$invensync/.venv/Scripts/python.exe"      # Windows
[ -x "$py" ] || py="$invensync/.venv/bin/python"
[ -x "$py" ] || { echo "dev_commit: .venv do InvenSync nao encontrado — kanban nao atualizado." >&2; exit 0; }

"$py" "$invensync/dev_commit.py" HEAD --repo "$repo"
exit 0
