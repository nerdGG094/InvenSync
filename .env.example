# === Modelo de configuração — copie para .env e preencha com valores reais ===
# cp .env.example .env   (ou copie manualmente no Windows)

# Flask — gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-secreta

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=inventario_almox
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres

# Alternativa: URL completa (sobrescreve as variáveis DB_* acima)
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/inventario_almox

# === Backup do banco (pg_dump) — opcional ===
# Pasta de destino e quantos backups manter (rotação). PG_DUMP só é necessário
# se o pg_dump.exe não estiver no caminho padrão do PostgreSQL.
BACKUP_DIR=
BACKUP_KEEP=30
# PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# 2º destino REDUNDANTE/OFFSITE (outro disco, pasta ou compartilhamento de rede).
# Fortemente recomendado: um backup no mesmo servidor se perde junto com ele.
# BACKUP_MIRROR_DIR=\\NAS\backups\invensync
#
# --- Backup na NUVEM (Google Drive) — duas opções ---
# OPÇÃO A (simples): instale o "Google Drive para computador", faça login com a
#   conta da empresa e aponte BACKUP_MIRROR_DIR para a pasta sincronizada, ex.:
#   BACKUP_MIRROR_DIR=G:\Meu Drive\Backups\InvenSync   (zero configuração extra)
# OPÇÃO B (servidor/headless, recomendada): rclone. Instale (winget install Rclone.Rclone),
#   configure uma vez (rclone config -> "gdrive" tipo drive, autorize no navegador) e:
# BACKUP_UPLOAD_CMD=rclone copy "{path}" gdrive:Backups/InvenSync --drive-chunk-size 32M
# Agendador interno de backup (dispensa a Tarefa Agendada externa do Windows):
BACKUP_SCHEDULER_ENABLED=1
BACKUP_HOUR=2

# === Segurança ===
# Exige 2FA dos administradores (admin sem 2FA é levado à configuração). 0 desliga.
FORCE_ADMIN_2FA=1

# === Alertas proativos (estoque/licenças/chamados) ===
ALERTS_ENABLED=1
ALERTS_TICKET_STUCK_HOURS=48
ALERTS_LICENSE_DAYS=30
# Digest por e-mail: horas do dia (no máx. 1 envio por janela). Ex.: cedo e ~17h.
ALERTS_DIGEST_HOURS=8,17
# De quanto em quanto tempo (min) o agendador acorda para checar.
ALERTS_CHECK_MINUTES=30

# === Notificações por e-mail (SMTP) — opcional ===
# Preencha estes valores APENAS no seu .env (nunca aqui no .env.example).
# Exemplo de host: mail.seuprovedor.com.br  | porta 587 (TLS) ou 465 (SSL)
MAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TI=

# === CFTV / câmeras dos DVRs ===
# Snapshot (sempre disponível): cache da grade e da câmera ampliada, em segundos.
DVR_SNAP_TTL=3
DVR_SNAP_TTL_LIVE=0.4
# --- Tempo real (WebRTC) via go2rtc — opcional, veja docs/GO2RTC.md ---
# Endereço do serviço go2rtc (o NAVEGADOR acessa direto). Vazio = só snapshot.
# GO2RTC_URL=http://192.168.0.54:1984
# Arquivo gerado pela tela /cftv/go2rtc (CONTÉM as senhas dos DVRs em texto puro).
# GO2RTC_CONFIG=C:\Users\Administrador\Desktop\python\INVENSYNC\InventarioAlmox\go2rtc\go2rtc.yaml
# RTSP dos DVRs: porta e qual stream usar.
#   subtype=0 = principal, 720p (HD) — nestes DVRs em H.265
#   subtype=1 = sub-stream, H.264 mas CIF 352x240 @7fps (leve e feio)
GO2RTC_RTSP_PORT=554
GO2RTC_SUBTYPE=0
# O WebRTC não transporta H.265: com o transcode ligado, cada canal ganha uma
# 2ª fonte ffmpeg que converte p/ H.264 SÓ enquanto alguém assiste. Custa CPU
# (~1 núcleo por espectador simultâneo). 0 = desliga (só H.265 puro).
GO2RTC_TRANSCODE=1
# ffmpeg.exe; vazio = procura ao lado do go2rtc.yaml e depois no PATH.
# GO2RTC_FFMPEG=
# Padrão Intelbras/Dahua (deixe vazio para usar o embutido). Campos disponíveis:
# {user} {password} {host} {port} {channel} {subtype}
# GO2RTC_RTSP_TEMPLATE=rtsp://{user}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype={subtype}
# Modo do player: webrtc (sub-segundo) com mse de reserva (ex.: canais H.265).
GO2RTC_PLAYER_MODE=webrtc,mse
# --- Detecção inteligente (humano/veículo) — quem detecta é o próprio DVR ---
# O InvenSync só escuta os eventos: não decodifica vídeo nem roda modelo de IA.
# Só funciona nos DVRs cujo firmware aceita ligar o SMD (aqui, o MHDX1232).
DVR_EVENTS_ENABLED=1
# Segundos que a caixa continua na tela sem novo evento (rede caiu, etc.).
DVR_DETECT_TTL=8
# E-mail à TI ao detectar PESSOA dentro da janela de vigilância. Vazio/0 = nunca.
DVR_ALERT_ENABLED=0
# DVR_ALERT_HOURS=19-6
# Intervalo mínimo (s) entre dois avisos do mesmo canal, p/ não inundar a caixa.
DVR_ALERT_COOLDOWN=900

# === Cofre de senhas (cifragem em repouso) ===
# Chave fixa do cofre (Fernet). Se vazio, deriva do SECRET_KEY — defina uma
# chave própria e ESTÁVEL em produção (mudá-la torna os segredos ilegíveis).
VAULT_KEY=

# === Sessão / segurança ===
# Logout automático por inatividade (minutos). 0 = desligado.
INACTIVITY_MINUTES=0
# Cabeçalhos de segurança (CSP, X-Frame-Options...). Deixe 1; 0 só p/ depurar.
SECURITY_HEADERS=1
# Bloqueio de conta após N senhas erradas, por X minutos.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Alertas de atividade suspeita na auditoria (e-mail à TI ao cruzar o limite na
# janela de ALERTS_CHECK_MINUTES). Ajuste os limites conforme o volume normal.
SECURITY_ALERTS_ENABLED=1
SEC_ALERT_LOGINFAIL=15
SEC_ALERT_REVEAL=20
SEC_ALERT_DELETE=25
# Ligue ambos APENAS ao servir por HTTPS atrás de proxy reverso (veja docs/HTTPS.md).
# BEHIND_PROXY=1
# SESSION_COOKIE_SECURE=1
