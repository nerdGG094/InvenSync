# === Modelo de configuração — copie para .env e preencha com valores reais ===
# cp .env.example .env   (ou copie manualmente no Windows)

# Flask — gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-secreta

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=inventario_almox
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres

# Alternativa: URL completa (sobrescreve as variáveis DB_* acima)
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/inventario_almox

# === Backup do banco (pg_dump) — opcional ===
# Pasta de destino e quantos backups manter (rotação). PG_DUMP só é necessário
# se o pg_dump.exe não estiver no caminho padrão do PostgreSQL.
BACKUP_DIR=
BACKUP_KEEP=30
# PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# 2º destino REDUNDANTE/OFFSITE — outro disco, pasta de rede ou NAS. Fortemente
# recomendado: um backup só no próprio servidor se perde junto com ele. É uma
# cópia simples da pasta de backup para o caminho abaixo, a cada dump.
# BACKUP_MIRROR_DIR=\\OUTRO-SERVIDOR\backups\invensync
# BACKUP_MIRROR_DIR=X:\Backups\InvenSync
# Agendador interno de backup (dispensa a Tarefa Agendada externa do Windows):
BACKUP_SCHEDULER_ENABLED=1
BACKUP_HOUR=2
# De quanto em quanto tempo a thread confere se já passou da hora (segundos).
# Ela também faz o self-heal: se o servidor estava desligado às 2h, o backup
# sai na primeira verificação depois que ele sobe.
BACKUP_CHECK_SECONDS=1800

# === Segurança ===
# Exige 2FA dos administradores (admin sem 2FA é levado à configuração). 0 desliga.
FORCE_ADMIN_2FA=1

# === Alertas proativos (estoque/licenças/chamados) ===
ALERTS_ENABLED=1
ALERTS_TICKET_STUCK_HOURS=48
ALERTS_LICENSE_DAYS=30
# Digest por e-mail: horas do dia (no máx. 1 envio por janela). Ex.: cedo e ~17h.
ALERTS_DIGEST_HOURS=8,17
# De quanto em quanto tempo (min) o agendador acorda para checar.
ALERTS_CHECK_MINUTES=30

# === Notificações por e-mail (SMTP) — opcional ===
# Preencha estes valores APENAS no seu .env (nunca aqui no .env.example).
# Exemplo de host: mail.seuprovedor.com.br  | porta 587 (TLS) ou 465 (SSL)
MAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TI=

# === CFTV / câmeras dos DVRs ===
# Snapshot (sempre disponível): cache da grade e da câmera ampliada, em segundos.
DVR_SNAP_TTL=3
DVR_SNAP_TTL_LIVE=0.4
# --- Tempo real (WebRTC) via go2rtc — opcional, veja docs/GO2RTC.md ---
# Endereço do serviço go2rtc (o NAVEGADOR acessa direto). Vazio = só snapshot.
# GO2RTC_URL=http://192.168.0.54:1984
# Arquivo gerado pela tela /cftv/go2rtc (CONTÉM as senhas dos DVRs em texto puro).
# GO2RTC_CONFIG=C:\Users\Administrador\Desktop\python\INVENSYNC\InventarioAlmox\go2rtc\go2rtc.yaml
# RTSP dos DVRs: porta e qual stream usar.
#   subtype=0 = principal, 720p (HD) — nestes DVRs em H.265
#   subtype=1 = sub-stream, H.264 mas CIF 352x240 @7fps (leve e feio)
# Segundos de espera ao sondar o serviço (/api/streams) — a página de CFTV não
# pode ficar pendurada se o go2rtc estiver fora do ar.
GO2RTC_TIMEOUT=3
GO2RTC_RTSP_PORT=554
GO2RTC_SUBTYPE=0
# O WebRTC não transporta H.265: com o transcode ligado, cada canal ganha uma
# 2ª fonte ffmpeg que converte p/ H.264 SÓ enquanto alguém assiste. Custa CPU
# (~1 núcleo por espectador simultâneo). 0 = desliga (só H.265 puro).
GO2RTC_TRANSCODE=1
# ffmpeg.exe; vazio = procura ao lado do go2rtc.yaml e depois no PATH.
# GO2RTC_FFMPEG=
# Padrão Intelbras/Dahua (deixe vazio para usar o embutido). Campos disponíveis:
# {user} {password} {host} {port} {channel} {subtype}
# GO2RTC_RTSP_TEMPLATE=rtsp://{user}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype={subtype}
# Modo do player: webrtc (sub-segundo) com mse de reserva (ex.: canais H.265).
GO2RTC_PLAYER_MODE=webrtc,mse
# --- Detecção inteligente (humano/veículo) — quem detecta é o próprio DVR ---
# O InvenSync só escuta os eventos: não decodifica vídeo nem roda modelo de IA.
# Só funciona nos DVRs cujo firmware aceita ligar o SMD (aqui, o MHDX1232).
DVR_EVENTS_ENABLED=1
# Segundos que a caixa continua na tela sem novo evento (rede caiu, etc.).
DVR_DETECT_TTL=8
# Dias de historico de deteccao a manter (faxina diaria). 0 = guarda tudo.
# Medido em producao: ~6.900 linhas/dia. Com o default de 90 a tabela vira a
# maior do banco e entra inteira em cada dump; 30 dias cobrem apuracao real.
DVR_DETECT_KEEP_DAYS=30
# E-mail à TI ao detectar PESSOA dentro da janela de vigilância. Vazio/0 = nunca.
DVR_ALERT_ENABLED=0
# DVR_ALERT_HOURS=19-6
# Intervalo mínimo (s) entre dois avisos do mesmo canal, p/ não inundar a caixa.
DVR_ALERT_COOLDOWN=900

# === Monitoramento de uptime (ping/HTTP em segundo plano) ===
# Thread que testa os hosts monitorados e avisa a TI quando algo cai/volta.
# Impressoras, DVRs e roteadores com IP fixo entram aqui sozinhos.
MONITORING_ENABLED=1
MONITORING_INTERVAL=120

# === Impressoras de rede (SNMP, porta 161/UDP) ===
# Comunidade de leitura e tempo de espera por resposta (segundos).
SNMP_COMMUNITY=public
SNMP_TIMEOUT=3
# Coleta periódica: grava o histórico de páginas/toner/cilindro e avisa a TI
# quando um suprimento cruza o percentual abaixo.
PRINTER_MONITOR_ENABLED=1
PRINTER_MONITOR_MINUTES=60
PRINTER_SUPPLY_ALERT_PCT=10
# Troca física detectada: o nível subiu ao menos JUMP pontos E chegou a PCT.
# É o que dispara a baixa automática do toner/cilindro no estoque.
PRINTER_REPLACE_PCT=80
PRINTER_REPLACE_JUMP=40

# === Tomadas inteligentes (Tuya/NeoAvant na LAN) ===
# Agendador que liga/desliga por horário.
PLUG_SCHEDULER_ENABLED=1
# Aviso de tomada offline: de quanto em quanto tempo checar e a partir de
# quantos minutos fora avisar a TI por e-mail.
PLUG_OFFLINE_CHECK_MINUTES=10
PLUG_OFFLINE_ALERT_MINUTES=30

# === Cofre de senhas (cifragem em repouso) ===
# Chave fixa do cofre (Fernet). Se vazio, deriva do SECRET_KEY — defina uma
# chave própria e ESTÁVEL em produção (mudá-la torna os segredos ilegíveis).
VAULT_KEY=
# Minutos que a re-autenticação (senha do próprio usuário) vale antes de o cofre
# pedir de novo para revelar/copiar uma senha. 0 = pede toda vez.
VAULT_REAUTH_MINUTES=5

# === Sessão / segurança ===
# Nome dos cookies. NÃO use os padrões do Flask (`session`/`remember_token`):
# cookie é isolado por domínio, NUNCA por porta, então dois apps Flask no mesmo
# servidor gravam o MESMO cookie e um sobrescreve a sessão do outro — o usuário
# cai no login sem mensagem e o CSRF passa a falhar. Já aconteceu aqui. Um app
# novo neste servidor precisa de nomes próprios também.
SESSION_COOKIE_NAME=invensync_session
REMEMBER_COOKIE_NAME=invensync_remember
# Logout automático por inatividade (minutos). 0 = desligado.
INACTIVITY_MINUTES=0
# Cabeçalhos de segurança (CSP, X-Frame-Options...). Deixe 1; 0 só p/ depurar.
SECURITY_HEADERS=1

# === Aparência ===
# Fundo animado de bolhas em todas as telas. Roda no navegador de quem usa
# (WebGL), não no servidor — mas em máquina fraca pode deixar o sistema lento.
# Coloque 0 para desligar, ou baixe a densidade (0.15 = bem discreto).
UI_FUNDO_BOLHAS=1
UI_FUNDO_DENSIDADE=0.3
# Bloqueio de conta após N senhas erradas, por X minutos.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Alertas de atividade suspeita na auditoria (e-mail à TI ao cruzar o limite na
# janela de ALERTS_CHECK_MINUTES). Ajuste os limites conforme o volume normal.
SECURITY_ALERTS_ENABLED=1
SEC_ALERT_LOGINFAIL=15
SEC_ALERT_REVEAL=20
SEC_ALERT_DELETE=25
# Ligue ambos APENAS ao servir por HTTPS atrás de proxy reverso (veja docs/HTTPS.md).
# BEHIND_PROXY=1
# SESSION_COOKIE_SECURE=1

# === Board DEV: registro automático de commits (hook post-commit) ===
# Instale o hook uma vez: powershell -ExecutionPolicy Bypass -File setup\instalar_hooks.ps1
# Cada commit vira card em Revisão; se a mensagem citar #12, vira atualização da
# tarefa 12. Use [skip-kanban] na mensagem para ignorar um commit específico.
# O board atende varios repositorios: instale o hook nos outros com
#   setup\instalar_hooks.ps1 -Repo C:\...\CARREG-LOGI
# O nome da pasta do projeto vira a primeira tag do card.
DEV_COMMIT_ENABLED=1
DEV_COMMIT_USER_EMAIL=ti@refrigerantesjaboti.com.br
DEV_COMMIT_STATUS=review
# Commits de rotina que nao viram card (regex no assunto). O CARREG-LOGI comita
# um backup automatico a cada 15 min.
# DEV_COMMIT_IGNORAR=^(backup autom[aá]tico|wip\b|auto[- ]?commit)
